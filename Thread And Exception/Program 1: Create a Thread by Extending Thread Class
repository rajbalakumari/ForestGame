class MyThread extends Thread {

    public void run() {
        for (int i = 1; i <= 5; i++) {
            System.out.println("Thread Running : " + i);
        }
    }
}

public class ThreadDemo1 {

    public static void main(String[] args) {

        MyThread t = new MyThread();
        t.start();

        System.out.println("Main Method End");
    }
}
